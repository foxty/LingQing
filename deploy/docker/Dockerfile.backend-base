# Base Image for Backend Services
# Contains: Python runtime, system dependencies, and all Python packages
# Build trigger: When dependencies change (uv.lock modified) or manual
# Versioning: Semantic (base-v1, base-v2, etc.)

FROM python:3.11-slim

# Install system dependencies (including dev tools for building packages).
# Chromium + libs: required by Plotly/Kaleido (fig.to_image) for server-side chart SVG export.
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    postgresql-client \
    chromium \
    libnss3 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libxkbcommon0 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Install uv for faster package management
RUN pip install --no-cache-dir uv

# Set working directory
WORKDIR /app

# Create non-root user and set ownership for workspace
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

# Copy workspace configuration and dependency files
# These files define what packages to install (single unified backend)
COPY --chown=appuser:appuser pyproject.toml uv.lock* ./
COPY --chown=appuser:appuser apps/tenant_app_service/pyproject.toml ./apps/tenant_app_service/
COPY --chown=appuser:appuser apps/scheduler_service/pyproject.toml ./apps/scheduler_service/
COPY --chown=appuser:appuser apps/tenant_manager_service/pyproject.toml ./apps/tenant_manager_service/
COPY --chown=appuser:appuser apps/shared/pyproject.toml ./apps/shared/

# Install all workspace dependencies (excludes dev packages)
# This is the expensive operation we want to cache
USER appuser
RUN uv sync --no-dev

# Metadata labels
LABEL maintainer="LingQing Team"
LABEL description="Base image with Python dependencies for LingQing backend"
LABEL usage="This image is intended as a base for backend-app image, not for direct use"
