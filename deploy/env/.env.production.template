# LingQing production — remote VM environment
#
# BOOTSTRAP CHECKLIST (once per environment)
# ─────────────────────────────────────────
# [ ] 1. Provision external PostgreSQL 14+; allow app VM → port 5432
# [ ] 2. Run init_db.sh (release bundle or repo) — creates DBs/users; save passwords
# [ ] 3. cp .env.template .env — fill every empty variable below
# [ ] 4. ./bootstrap.sh --version vX.Y.Z --registry ghcr.io/ORG/lingqing
# [ ] 5. Outer Nginx/TLS → proxy to localhost:8080 (docs/deploy/reference.md)
# [ ] 6. Create first tenant (manager portal or tenant-cli)
#
# Full variable reference: docs/deploy/reference.md

# =============================================================================
# FILL BEFORE DEPLOY
# bootstrap.sh validates .env against .env.template (empty template values must be filled); checks:
# APP_PUBLIC_URL, MANAGER_PUBLIC_URL (must not stay example.com)
# =============================================================================

# --- Security ---
# Generate: openssl rand -hex 32
SECRET_KEY=

# --- Public URLs ---
# bootstrap.sh derives CORS_ORIGINS, PORTAL_ORIGIN, TENANT_APP_API_ORIGIN from these.
APP_PUBLIC_URL=https://app.example.com
MANAGER_PUBLIC_URL=https://manager.example.com

# --- PostgreSQL (external — compose stack does NOT include Postgres) ---
# Passwords must match those passed to init_db.sh.
# When both DBs share one server, set TENANT_MANAGER_DB_HOST to the same host
# (or leave empty — bootstrap copies TENANT_APP_DB_HOST automatically).
#
# App database (lq_tenant_app / lq_tenant_app_db_user)
TENANT_APP_DB_HOST=
TENANT_APP_DB_PORT=5432
TENANT_APP_DB_NAME=lq_tenant_app
TENANT_APP_DB_USER=lq_tenant_app_db_user
TENANT_APP_DB_PASSWORD=
TENANT_APP_DB_SSL_MODE=require
#
# Manager database (lq_tenant_manager / lq_tenant_manager_db_user)
TENANT_MANAGER_DB_HOST=
TENANT_MANAGER_DB_PORT=5432
TENANT_MANAGER_DB_NAME=lq_tenant_manager
TENANT_MANAGER_DB_USER=lq_tenant_manager_db_user
TENANT_MANAGER_DB_PASSWORD=
TENANT_MANAGER_DB_SSL_MODE=require

# --- Persistent data (host directory bind-mounted to /app/data in containers) ---
DATA_ROOT_HOST_PATH=/var/lib/lingqing/data

# =============================================================================
# DEFAULTS — remote Docker stack; change only if your setup differs
# =============================================================================

# --- Gateway / multi-tenant ---
GATEWAY_SERVICE_PORT=8080
TENANT_MODE=multi

# --- In-container paths and storage ---
FILE_STORAGE_TYPE=local
DATA_ROOT_HOST_PATH=/var/lib/lingqing/data
DATA_ROOT_PATH=/app/data

# --- Internal service endpoints (Docker network) ---
CHART_SERVICE_URL=/api/
CHROMA_MODE=http
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION_PREFIX=tenant_
VECTOR_INDEXING_MODE=async
AGENT_SANDBOX_BASE_URL=http://sandbox-controller:8090

# --- Logging ---
LOG_LEVEL=info
TOKENIZERS_PARALLELISM=false

# --- Sandbox controller (required by sandbox-controller container) ---
# SANDBOX_RUNNER_IMAGE is overridden in docker-compose.yml from REGISTRY_URL + VERSION.
SANDBOX_MAX_TIMEOUT_SECONDS=60
SANDBOX_OUTPUT_MAX_BYTES=262144
SANDBOX_MAX_COMMAND_CHARS=8000
SANDBOX_MAX_PARALLEL_WORKERS=5
SANDBOX_MAX_QUEUE_SIZE=100
SANDBOX_PER_TENANT_PARALLEL_LIMIT=3
SANDBOX_RUNNER_CPU_LIMIT=0.5
SANDBOX_RUNNER_MEMORY_LIMIT=512m
SANDBOX_RUNNER_PIDS_LIMIT=64
SANDBOX_RUNNER_NETWORK_MODE=none
SANDBOX_RUNNER_SSL_NO_VERIFY=0

# --- Bundled Postgres (only when using ./bootstrap.sh --with-postgres) ---
# bootstrap sets TENANT_*_DB_HOST=postgres, port 5432, SSL prefer if unset.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
