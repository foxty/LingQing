# LingQing production — minimal VM config
# 1. Fill REQUIRED fields below
# 2. cp .env.template .env && edit
# 3. ./init_db.sh (once, before bootstrap — see README.md)
# 4. ./bootstrap.sh --version vX.Y.Z --registry ghcr.io/ORG/lingqing
#
# Full reference: docs/deploy/reference.md

# =============================================================================
# REQUIRED — edit before deploy
# =============================================================================
SECRET_KEY=
TENANT_APP_DB_HOST=
TENANT_APP_DB_PASSWORD=
TENANT_MANAGER_DB_HOST=
TENANT_MANAGER_DB_PASSWORD=
DATA_ROOT_HOST_PATH=/var/lib/lingqing/data
APP_PUBLIC_URL=https://app.example.com
MANAGER_PUBLIC_URL=https://manager.example.com

# bootstrap.sh derives CORS_ORIGINS, PORTAL_ORIGIN, TENANT_APP_API_ORIGIN from URLs.
# TENANT_MANAGER_DB_HOST: use same value as TENANT_APP_DB_HOST when both DBs share one PG server.

# =============================================================================
# Defaults (remote Docker stack — usually no change)
# =============================================================================
GATEWAY_SERVICE_PORT=8080
TENANT_MODE=multi
TENANT_APP_DB_PORT=5432
TENANT_APP_DB_NAME=lq_tenant_app
TENANT_APP_DB_USER=lq_tenant_app_db_user
TENANT_APP_DB_SSL_MODE=require
TENANT_MANAGER_DB_PORT=5432
TENANT_MANAGER_DB_NAME=lq_tenant_manager
TENANT_MANAGER_DB_USER=lq_tenant_manager_db_user
TENANT_MANAGER_DB_SSL_MODE=require
DATA_ROOT_PATH=/app/data
FILE_STORAGE_TYPE=local
CHART_SERVICE_URL=/api/
CHROMA_MODE=http
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION_PREFIX=tenant_
VECTOR_INDEXING_MODE=async
AGENT_SANDBOX_BASE_URL=http://sandbox-controller:8090
LOG_LEVEL=info
TOKENIZERS_PARALLELISM=false
