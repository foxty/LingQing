# ============================================================
# LingQing 环境配置模板
# ============================================================
# 本地开发: cp .env.template ../.env.local
# Docker部署: cp .env.template .env
# Compose E2E:  cp deploy/env/.env.template deploy/env/.env.e2e（TENANT_APP_DB_HOST=postgres, TENANT_APP_DB_PORT=5432 等）；host 端口固定见 full-stack.yml（5433/18080）
#
# Placeholder format:
# - <env:VAR-default> means VAR can be overridden and has a default value.
# - <env:VAR-> means default value is empty string.
# - <env:VAR> means VAR is required and has no default.

# ==================== 【安全配置】必须 ====================
# 生成密钥: openssl rand -hex 32
SECRET_KEY=<env:SECRET_KEY->

# ==================== 【多租户配置】必须 ====================
TENANT_MODE=<env:TENANT_MODE-multi>
# TENANT_DEFAULT_ID=1  # 仅当使用单租户模式时需要

# ==================== 【数据库配置】必须 ====================
# Connection port (Postgres always listens on 5432 inside containers).
# dev infra compose also uses TENANT_APP_DB_PORT for host bind (5432:5432).
# E2E host bind is fixed at 5433 in full-stack.yml; keep TENANT_APP_DB_PORT=5432 in .env.e2e.
TENANT_APP_DB_HOST=<env:TENANT_APP_DB_HOST-localhost>
TENANT_APP_DB_PORT=<env:TENANT_APP_DB_PORT-5432>
TENANT_APP_DB_NAME=<env:TENANT_APP_DB_NAME-lq_tenant_app>
TENANT_APP_DB_USER=<env:TENANT_APP_DB_USER-lq_tenant_app_db_user>
TENANT_APP_DB_PASSWORD=<env:TENANT_APP_DB_PASSWORD->
TENANT_APP_DB_SSL_MODE=<env:TENANT_APP_DB_SSL_MODE-prefer>

# Tenant Manager 控制面数据库
# 留空时 tenant_manager_service 自动回退到 TENANT_APP_DB_*
TENANT_MANAGER_DB_HOST=<env:TENANT_MANAGER_DB_HOST-localhost>
TENANT_MANAGER_DB_PORT=<env:TENANT_MANAGER_DB_PORT-5432>
TENANT_MANAGER_DB_NAME=<env:TENANT_MANAGER_DB_NAME-lq_tenant_manager>
TENANT_MANAGER_DB_USER=<env:TENANT_MANAGER_DB_USER-lq_tenant_manager_db_user>
TENANT_MANAGER_DB_PASSWORD=<env:TENANT_MANAGER_DB_PASSWORD->
TENANT_MANAGER_DB_SSL_MODE=<env:TENANT_MANAGER_DB_SSL_MODE-prefer>

# ==================== 【存储配置】必须 ====================
# In-container data root (Python, static files, tenant dirs). Use /app/data for Docker stacks.
DATA_ROOT_PATH=<env:DATA_ROOT_PATH-/app/data>
# deploy/compose/local and remote stacks: absolute host directory bind-mounted to /app/data (override for
# local dev). Default follows FHS-style service state under /var/lib. Needed for sandbox-controller nested docker binds.
DATA_ROOT_HOST_PATH=<env:DATA_ROOT_HOST_PATH-/var/lib/lingqing/data>

# 文件存储类型：local 或 s3
FILE_STORAGE_TYPE=<env:FILE_STORAGE_TYPE-local>

# S3 存储配置（仅当 FILE_STORAGE_TYPE=s3 时需要）
# S3_BUCKET=your-bucket-name
# S3_REGION=us-west-2
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# OBJECT_STORAGE_ACCESS_KEY=your-access-key
# OBJECT_STORAGE_SECRET_KEY=your-secret-key

# ==================== 【服务 / 端口】 ====================
# Internal service ports are fixed in Docker (app=8000, manager=8010, gateway=80, sandbox=8090, chroma=8000).
# Only configure connection endpoints below — not compose host bindings unless noted.
#
# Tier cheat sheet (host access):
#   dev infra  — postgres/CHROMA/DOCLING via .env.local; app/sandbox via npm run dev:ta
#   e2e stack  — gateway :18080, postgres :5433 (fixed in compose/local/full-stack.yml)
#   remote VM  — gateway via GATEWAY_SERVICE_PORT (8080 prod; staging override uses 18080)

# Remote production gateway host bind (deploy/compose/remote/stack.yml only)
GATEWAY_SERVICE_PORT=<env:GATEWAY_SERVICE_PORT-8080>

# Frontend Vite dev servers (npm run dev:ta / dev:tm)
TENANT_APP_PORTAL_PORT=<env:TENANT_APP_PORTAL_PORT-5173>
TENANT_MANAGER_PORTAL_PORT=<env:TENANT_MANAGER_PORTAL_PORT-5174>

# 图表服务 URL
CHART_SERVICE_URL=<env:CHART_SERVICE_URL-/api/>

# CORS 允许源
CORS_ORIGINS=<env:CORS_ORIGINS-http://localhost:5173,http://localhost:5174>

# ==================== SSO / OIDC 配置 ====================
# These are PUBLIC origins (scheme + host) the browser/IdP can reach, NOT internal
# service addresses. Behind a proxy/gateway, set them to the external-facing URL.
#
# Tenant app portal origin (browser). After a successful SSO callback, the API
# redirects the browser here to exchange the one-time ticket for a session.
PORTAL_ORIGIN=<env:PORTAL_ORIGIN-http://localhost:5173>
#
# Public origin of the tenant-app-service API. Used to build the absolute OIDC
# redirect_uri sent to the IdP. MUST equal the callback URL admins register at
# their IdP (shown in Settings > SSO). Mismatch => IdP returns 400 invalid_request.
# Local dev: http://localhost:8000 ; prod: the external API URL (e.g. via gateway).
TENANT_APP_API_ORIGIN=<env:TENANT_APP_API_ORIGIN-http://localhost:8000>

# 向量索引更新模式：sync（请求时同步更新，适合小规模数据和高一致性需求）或 async（异步后台更新，适合大规模数据和更快响应）
VECTOR_INDEXING_MODE=<env:VECTOR_INDEXING_MODE-async>

# Chroma 向量库模式：embedded（进程内本地）或 http（客户端/服务端）
CHROMA_MODE=<env:CHROMA_MODE-http>
# 当 CHROMA_MODE=http 时生效
# dev: http://localhost:8002 (infra 发布 8002:8000)
# e2e/remote docker: http://chroma:8000
CHROMA_URL=<env:CHROMA_URL-http://localhost:8002>
CHROMA_COLLECTION_PREFIX=<env:CHROMA_COLLECTION_PREFIX-tenant_>

# ==================== Sandbox 配置 ====================
# Agent -> sandbox-controller client settings
# AGENT_SANDBOX_BASE_URL:
# - local docker compose: http://sandbox-controller:8090
# - host runtime:         http://localhost:8090
AGENT_SANDBOX_BASE_URL=<env:AGENT_SANDBOX_BASE_URL-http://sandbox-controller:8090>
AGENT_SANDBOX_DEFAULT_TIMEOUT_SECONDS=<env:AGENT_SANDBOX_DEFAULT_TIMEOUT_SECONDS-15>
AGENT_SANDBOX_MAX_TIMEOUT_SECONDS=<env:AGENT_SANDBOX_MAX_TIMEOUT_SECONDS-300>
AGENT_SANDBOX_OUTPUT_MAX_BYTES=<env:AGENT_SANDBOX_OUTPUT_MAX_BYTES-262144>
AGENT_SANDBOX_MAX_COMMAND_CHARS=<env:AGENT_SANDBOX_MAX_COMMAND_CHARS-24000>
# Client HTTP timeout = execution timeout + buffer seconds
AGENT_SANDBOX_CLIENT_TIMEOUT_BUFFER_SECONDS=<env:AGENT_SANDBOX_CLIENT_TIMEOUT_BUFFER_SECONDS-10>

# ==================== Scheduled Task Execution 配置 ====================
# Optional fixed instance id. Use `auto` (default) to auto-generate a unique value per process startup.
# Do not share one fixed value across multiple scheduler replicas.
SCHEDULER_INSTANCE_ID=<env:SCHEDULER_INSTANCE_ID-auto>
SCHEDULED_TASK_LEASE_TTL_SECONDS=<env:SCHEDULED_TASK_LEASE_TTL_SECONDS-90>
SCHEDULED_TASK_HEARTBEAT_INTERVAL_SECONDS=<env:SCHEDULED_TASK_HEARTBEAT_INTERVAL_SECONDS-15>
SCHEDULED_TASK_WATCHDOG_LIMIT=<env:SCHEDULED_TASK_WATCHDOG_LIMIT-100>

# sandbox-controller service settings
# Controller uses DATA_ROOT_PATH in-container; DATA_ROOT_HOST_PATH must match the host side of the /app/data bind mount.
SANDBOX_MAX_TIMEOUT_SECONDS=<env:SANDBOX_MAX_TIMEOUT_SECONDS-60>
SANDBOX_OUTPUT_MAX_BYTES=<env:SANDBOX_OUTPUT_MAX_BYTES-262144>
SANDBOX_MAX_COMMAND_CHARS=<env:SANDBOX_MAX_COMMAND_CHARS-8000>
SANDBOX_MAX_PARALLEL_WORKERS=<env:SANDBOX_MAX_PARALLEL_WORKERS-5>
SANDBOX_MAX_QUEUE_SIZE=<env:SANDBOX_MAX_QUEUE_SIZE-100>
SANDBOX_PER_TENANT_PARALLEL_LIMIT=<env:SANDBOX_PER_TENANT_PARALLEL_LIMIT-3>

# sandbox-runner container limits/settings
# Production should set SANDBOX_RUNNER_IMAGE to a registry image tag
# that matches the controller release version.
SANDBOX_RUNNER_IMAGE=<env:SANDBOX_RUNNER_IMAGE-sandbox-runner:dev>
SANDBOX_RUNNER_CPU_LIMIT=<env:SANDBOX_RUNNER_CPU_LIMIT-0.5>
SANDBOX_RUNNER_MEMORY_LIMIT=<env:SANDBOX_RUNNER_MEMORY_LIMIT-512m>
SANDBOX_RUNNER_PIDS_LIMIT=<env:SANDBOX_RUNNER_PIDS_LIMIT-64>
# Use "none" for maximum isolation. If changed, enforce egress policy.
SANDBOX_RUNNER_NETWORK_MODE=<env:SANDBOX_RUNNER_NETWORK_MODE-none>
# Set to 1 if your network uses an SSL inspection proxy (corporate environments). Leave empty otherwise.
SANDBOX_RUNNER_SSL_NO_VERIFY=<env:SANDBOX_RUNNER_SSL_NO_VERIFY-0>
# Platform API base URL for scripts running inside sandbox runners.
# Override when runners need to reach the API via internal service mesh or different host.
SANDBOX_RUNNER_API_BASE_URL=<env:SANDBOX_RUNNER_API_BASE_URL-http://tenant-app-service:8000>

# ==================== 【LLM 配置】 ====================
# LLM 配置已迁移到租户级别配置（通过前端 Settings 页面配置）
# 不再需要在这里配置环境变量

# ==================== 【日志配置】 ====================
LOG_LEVEL=<env:LOG_LEVEL-info>

# ==================== Document parsing ====================
# Parser: default (built-in) | docling | mineru
DOCUMENT_PARSER=<env:DOCUMENT_PARSER-default>
# Start docling-serve with infra-up when true, even if DOCUMENT_PARSER=default
DOCLING_ENABLED=<env:DOCLING_ENABLED-false>
DOCLING_SERVICE_URL=<env:DOCLING_SERVICE_URL-http://docling-serve:5001>
DOCLING_TASK_TIMEOUT_SECONDS=<env:DOCLING_TASK_TIMEOUT_SECONDS-600>
# Optional auth: set the same value on backend (DOCLING_API_KEY) and docling-serve (DOCLING_SERVE_API_KEY in prod .env).
DOCLING_API_KEY=<env:DOCLING_API_KEY->
DOCLING_SERVE_ENABLE_UI=<env:DOCLING_SERVE_ENABLE_UI-0>
# dev infra compose host bind only (infra.yml); E2E docling is internal-only
DOCLING_HOST_PORT=<env:DOCLING_HOST_PORT-5001>
DOCLING_MEM_LIMIT=<env:DOCLING_MEM_LIMIT-8g>
DOCLING_CPUS=<env:DOCLING_CPUS-2.0>
# OCR is off for PDFs/office docs; set true for scanned PDFs. Images always OCR.
DOCLING_DO_OCR=<env:DOCLING_DO_OCR-false>
# Reject oversized docs instead of OOM-killing the worker
DOCLING_SERVE_MAX_NUM_PAGES=<env:DOCLING_SERVE_MAX_NUM_PAGES-200>
# Pin image (keep in sync with deploy/env/docling.version and tests/fixtures/parsing/manifest.json)
DOCLING_IMAGE=<env:DOCLING_IMAGE-quay.io/docling-project/docling-serve-cpu:v1.34.0>
MINERU_SERVICE_URL=<env:MINERU_SERVICE_URL->
MINERU_TASK_TIMEOUT_SECONDS=<env:MINERU_TASK_TIMEOUT_SECONDS-900>
DOCUMENT_PARSE_JOB_BATCH_SIZE=<env:DOCUMENT_PARSE_JOB_BATCH_SIZE-10>
#
# E2E (.env.e2e) overrides: TENANT_APP_DB_HOST=postgres, TENANT_APP_DB_PORT=5432,
# CHROMA_URL=http://chroma:8000, AGENT_SANDBOX_BASE_URL=http://sandbox-controller:8090,
# DOCLING_SERVICE_URL=http://docling-serve:5001, DATA_ROOT_HOST_PATH=...
# Host ports (postgres 5433, gateway 18080) are fixed in compose/local/full-stack.yml.
#
# Dev on host with Docling in infra: DOCLING_SERVICE_URL=http://127.0.0.1:5001 (match DOCLING_HOST_PORT)

# ==================== 【Python 环境】 ====================
# 禁用 tokenizers 并行以避免 fork 后的死锁警告
TOKENIZERS_PARALLELISM=<env:TOKENIZERS_PARALLELISM-false>
