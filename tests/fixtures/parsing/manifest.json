      "quality": {
        "min_table_blocks": 1,
        "must_contain": [],
        "max_chunks": 30
      }
    },
    {
      "id": "newspaper_pdf",
      "source_file": "newspaper.pdf",
      "baseline": "baselines/newspaper_pdf.blocks.golden.json",
      "description": "Multi-column newspaper PDF.",
      "quality": {
        "must_contain": []
      }
    },
    {
      "id": "illustrated_book_pdf",
      "source_file": "illustratedBook.pdf",
      "baseline": "baselines/illustrated_book_pdf.blocks.golden.json",
      "description": "Illustrated book PDF with mixed text and images.",
      "quality": {
        "must_contain": []
      }
