{
  "docling_image": "quay.io/docling-project/docling-serve-cpu:v1.34.0",
  "unit_fixtures": [
    {
      "id": "deck_4_slides",
      "description": "Slide deck blocks should chunk into a small number of segments.",
      "golden_blocks": "deck_4_slides.blocks.golden.json",
      "quality": {
        "max_blocks": 6,
        "min_text_blocks": 4,
        "max_chunks": 6,
        "min_median_chunk_chars": 30,
        "must_contain": [
          "01",
          "Goals",
          "Summary",
          "Thanks"
        ]
      }
    },
    {
      "id": "table_report",
      "description": "Report with a single merged table block.",
      "golden_blocks": "table_report.blocks.golden.json",
      "quality": {
        "min_table_blocks": 1,
        "max_chunks": 4,
        "min_median_chunk_chars": 40,
        "must_contain": [
          "Region",
          "Revenue"
        ]
      }
    },
    {
      "id": "headings_memo",
      "description": "Memo with section headings prefixed into chunk text.",
      "golden_blocks": "headings_memo.blocks.golden.json",
      "quality": {
        "min_heading_blocks": 2,
        "max_chunks": 4,
        "min_median_chunk_chars": 50,
        "must_contain": [
          "Executive Summary",
          "Recommendations"
        ]
      }
    },
    {
      "id": "duplicate_title",
      "description": "Document with consecutive duplicate headings removed.",
      "golden_blocks": "duplicate_title.blocks.golden.json",
      "quality": {
        "max_heading_blocks": 1,
        "max_chunks": 3,
        "must_contain": [
          "Same Title",
          "meaningful"
        ]
      }
    }
  ],
  "integration_fixtures": [
    {
